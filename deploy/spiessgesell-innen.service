[Unit]
Description=spießgesell:innen (doner review club)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hermes/work/doner
EnvironmentFile=/home/hermes/work/doner/.env
Environment=DATA_DIR=/home/hermes/work/doner/data-prod
Environment=BACKUP_ENABLED=1
Environment=BACKUP_DIR=/home/hermes/backups/spiessgesell-innen
Environment=BACKUP_KEEP=14
Environment=BACKUP_AT=03:15
Environment=TZ=Europe/Berlin
ExecStart=/home/hermes/work/doner/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8095 --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

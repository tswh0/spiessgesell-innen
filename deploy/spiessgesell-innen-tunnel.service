[Unit]
Description=Quick Cloudflare tunnel for spießgesell:innen (temporary)
After=network-online.target spiessgesell-innen.service

[Service]
Type=simple
ExecStart=/home/hermes/.local/bin/cloudflared tunnel --url http://127.0.0.1:8095 --no-autoupdate
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
